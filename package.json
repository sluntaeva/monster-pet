{
  "name": "monster-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "bot": "node --env-file-if-exists=.env --import tsx server/bot.ts",
    "start": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.17.0 <23"
  }
}
